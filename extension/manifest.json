{
	"manifest_version": 3,
	"name": "UW Sidequest",
	"version": "0.2.2",
	"description": "A cleaner Quest class search with UW Flow ratings, and Quest's instructors, rooms and status on UW Flow.",
	"icons": {
		"128": "icons/sidequest-128.png"
	},
	"permissions": ["storage"],
	"host_permissions": ["https://quest.pecs.uwaterloo.ca/*"],
	"background": {
		"service_worker": "background.js",
		"scripts": ["quest.js", "background.js"]
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"content_scripts": [
		{
			"matches": ["https://uwflow.com/*"],
			"js": ["uwflow.js"],
			"css": ["uwflow.css"],
			"run_at": "document_idle"
		},
		{
			"matches": ["https://quest.pecs.uwaterloo.ca/*"],
			"js": ["quest.js", "questtab.js", "questsearch.js", "questpage.js"],
			"css": ["questsearch.css"],
			"all_frames": true,
			"run_at": "document_idle"
		}
	],
	"browser_specific_settings": {
		"gecko": {
			"id": "sidequest@hamza.sh",
			"strict_min_version": "140.0",
			"data_collection_permissions": { "required": ["websiteContent"] }
		}
	}
}
